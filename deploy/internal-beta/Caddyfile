{
	auto_https off
	admin off
	# Clients dial the bare IP without SNI (RFC 6066 forbids IP literals),
	# so the IP site's certificate must also serve SNI-less handshakes.
	default_sni {$AERA_INTERNAL_BETA_IP}
}

http://{$AERA_INTERNAL_BETA_IP} {
	handle /.well-known/acme-challenge/* {
		root * /var/lib/aera-certbot
		file_server
	}

	redir https://{$AERA_INTERNAL_BETA_IP}{uri} permanent
}

https://{$AERA_INTERNAL_BETA_IP} {
	tls /etc/letsencrypt/live/{$AERA_INTERNAL_BETA_CERTIFICATE_NAME}/fullchain.pem /etc/letsencrypt/live/{$AERA_INTERNAL_BETA_CERTIFICATE_NAME}/privkey.pem
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Access logging is intentionally omitted: OAuth start URLs contain
	# short-lived state and public device metadata in their query string.
	@private_admin path /admin /admin/*
	respond @private_admin 404

	reverse_proxy 127.0.0.1:18086 {
		health_uri /health/ready
		health_interval 30s
	}
}
