{
	auto_https off
	admin off
}

http://{$AERA_INTERNAL_BETA_IP} {
	handle /.well-known/acme-challenge/* {
		root * /var/lib/aera-certbot
		file_server
	}

	redir https://{$AERA_INTERNAL_BETA_IP}{uri} permanent
}

https://{$AERA_INTERNAL_BETA_IP} {
	tls /etc/letsencrypt/live/{$AERA_INTERNAL_BETA_CERTIFICATE_NAME}/fullchain.pem /etc/letsencrypt/live/{$AERA_INTERNAL_BETA_CERTIFICATE_NAME}/privkey.pem
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Access logging is intentionally omitted: OAuth start URLs contain
	# short-lived state and public device metadata in their query string.
	reverse_proxy 127.0.0.1:18086 {
		health_uri /health/ready
		health_interval 30s
	}
}
