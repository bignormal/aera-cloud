{
	auto_https off
	admin off
	# Clients dial the bare IP without SNI (RFC 6066 forbids IP literals),
	# so the IP site's certificate must also serve SNI-less handshakes.
	default_sni {$AERA_INTERNAL_BETA_IP}
}

http://{$AERA_INTERNAL_BETA_IP} {
	handle /.well-known/acme-challenge/* {
		root * /var/lib/aera-certbot
		file_server
	}

	handle {
		redir https://{$AERA_INTERNAL_BETA_IP}{uri} permanent
	}
}

https://{$AERA_INTERNAL_BETA_IP} {
	tls /etc/letsencrypt/live/{$AERA_INTERNAL_BETA_CERTIFICATE_NAME}/fullchain.pem /etc/letsencrypt/live/{$AERA_INTERNAL_BETA_CERTIFICATE_NAME}/privkey.pem
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Access logging is intentionally omitted: OAuth start URLs contain
	# short-lived state and public device metadata in their query string.
	@private_admin path /admin /admin/*
	respond @private_admin 404

	@desktop_update_metadata path /desktop-updates/internal-beta/manifest.json /desktop-updates/internal-beta/manifest.sig
	handle @desktop_update_metadata {
		header Cache-Control "no-store"
		uri strip_prefix /desktop-updates/internal-beta
		root * /var/lib/aera/desktop-updates/internal-beta/current
		file_server
	}

	@desktop_update_release path /desktop-updates/internal-beta/releases/*
	handle @desktop_update_release {
		header Cache-Control "public, max-age=31536000, immutable"
		uri strip_prefix /desktop-updates/internal-beta
		root * /var/lib/aera/desktop-updates/internal-beta
		file_server
	}

	@runtime_update_metadata path /runtime-updates/stable/agentera-runtime-stable.index.json /runtime-updates/stable/agentera-runtime-stable.index.sig
	handle @runtime_update_metadata {
		header Cache-Control "no-store"
		uri strip_prefix /runtime-updates/stable
		root * /var/lib/aera/runtime-updates/stable/current
		file_server
	}

	@runtime_update_release path /runtime-updates/stable/releases/*
	handle @runtime_update_release {
		header Cache-Control "public, max-age=31536000, immutable"
		uri strip_prefix /runtime-updates/stable
		root * /var/lib/aera/runtime-updates/stable
		file_server
	}

	reverse_proxy 127.0.0.1:18086 {
		health_uri /health/ready
		health_interval 30s
	}
}
