{$AGENTERA_ACCOUNT_HOST} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Keep the application port loopback-only. Caddy terminates trusted HTTPS.
	# Access logging is intentionally omitted because OAuth begin URLs contain
	# short-lived state and public device metadata in their query string.
	reverse_proxy 127.0.0.1:18086 {
		health_uri /health/ready
		health_interval 30s
	}
}
