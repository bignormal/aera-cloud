# Local development values only. Production secrets must come from the deploy environment.
AGENTERA_CLOUD_ENVIRONMENT=development
AGENTERA_CLOUD_LISTEN_ADDR=127.0.0.1:8086
AGENTERA_CLOUD_PUBLIC_URL=http://127.0.0.1:8086
AGENTERA_CLOUD_DATABASE_URL=postgres://aera_cloud:aera-cloud-dev-only@127.0.0.1:55434/aera_cloud?sslmode=disable
AGENTERA_CLOUD_REDIS_ADDR=127.0.0.1:56381
AGENTERA_CLOUD_REDIS_USERNAME=aera_cloud
AGENTERA_CLOUD_REDIS_PASSWORD=aera-cloud-dev-only
AGENTERA_CLOUD_REDIS_DB=9

# Development-only identity key rings. Generate independent production secrets and inject them through the deploy environment.
AGENTERA_CLOUD_IDENTITY_ENCRYPTION_ACTIVE_KEY_ID=enc-dev-v1
AGENTERA_CLOUD_IDENTITY_ENCRYPTION_KEYS='{"enc-dev-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}'
AGENTERA_CLOUD_IDENTITY_LOOKUP_ACTIVE_KEY_ID=lookup-dev-v1
AGENTERA_CLOUD_IDENTITY_LOOKUP_KEYS='{"lookup-dev-v1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="}'

AGENTERA_CLOUD_VERIFICATION_CODE_ACTIVE_KEY_ID=code-dev-v1
AGENTERA_CLOUD_VERIFICATION_CODE_KEYS='{"code-dev-v1":"AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM="}'
AGENTERA_CLOUD_VERIFICATION_RECEIPT_ACTIVE_KEY_ID=receipt-dev-v1
AGENTERA_CLOUD_VERIFICATION_RECEIPT_KEYS='{"receipt-dev-v1":"BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU="}'
AGENTERA_CLOUD_VERIFICATION_REQUEST_HMAC_KEY=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ=

# Browser account sessions and password-login limits use keys independent from verification and identity indexes.
AGENTERA_CLOUD_BROWSER_SESSION_HMAC_KEY=BgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgY=
AGENTERA_CLOUD_LOGIN_RATE_HMAC_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
AGENTERA_CLOUD_BROWSER_COOKIE_NAME=agentera_dev_session
AGENTERA_CLOUD_BROWSER_SESSION_TTL_SECONDS=900
AGENTERA_CLOUD_LOGIN_IDENTITY_LIMIT=5
AGENTERA_CLOUD_LOGIN_IP_LIMIT=20
AGENTERA_CLOUD_LOGIN_WINDOW_SECONDS=600
AGENTERA_CLOUD_TERMS_VERSION=terms-2026-07
AGENTERA_CLOUD_PRIVACY_VERSION=privacy-2026-07

# Non-delivering local placeholders. Replace every value with the chosen production providers before deployment.
AGENTERA_CLOUD_SMTP_HOST=smtp.agentera.invalid
AGENTERA_CLOUD_SMTP_PORT=587
AGENTERA_CLOUD_SMTP_USERNAME=agentera-dev
AGENTERA_CLOUD_SMTP_PASSWORD=agentera-dev-only
AGENTERA_CLOUD_SMTP_FROM_ADDRESS=accounts@agentera.invalid
AGENTERA_CLOUD_SMTP_FROM_NAME=AgentEra
AGENTERA_CLOUD_SMS_ENDPOINT=https://sms.agentera.invalid/v1/messages
AGENTERA_CLOUD_SMS_API_KEY=agentera-dev-only
AGENTERA_CLOUD_SMS_SENDER_ID=AgentEra
AGENTERA_CLOUD_CAPTCHA_ENDPOINT=https://captcha.agentera.invalid/siteverify
AGENTERA_CLOUD_CAPTCHA_SECRET=agentera-dev-only

# Password hashes are code-versioned Argon2id v=19: 65536 KiB memory, 3 iterations, 1 lane, 16-byte salt, 32-byte output.
