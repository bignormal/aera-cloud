# Local development values only. Production secrets must come from the deploy environment.
AGENTERA_CLOUD_ENVIRONMENT=development
AGENTERA_CLOUD_LISTEN_ADDR=127.0.0.1:8086
AGENTERA_CLOUD_PUBLIC_URL=http://127.0.0.1:8086
AGENTERA_CLOUD_DATABASE_URL=postgres://aera_cloud:aera-cloud-dev-only@127.0.0.1:55434/aera_cloud?sslmode=disable
AGENTERA_CLOUD_REDIS_ADDR=127.0.0.1:56381
AGENTERA_CLOUD_REDIS_USERNAME=aera_cloud
AGENTERA_CLOUD_REDIS_PASSWORD=aera-cloud-dev-only
AGENTERA_CLOUD_REDIS_DB=9

# End-to-end encrypted Profile backups use a dedicated ciphertext-only object store.
# The feature remains disabled until explicitly enabled. Production credentials belong in the deploy secret store.
AGENTERA_CLOUD_ENCRYPTED_BACKUP_ENABLED=false
AGENTERA_CLOUD_ENCRYPTED_BACKUP_ENDPOINT=127.0.0.1:59010
AGENTERA_CLOUD_ENCRYPTED_BACKUP_BUCKET=aera-encrypted-backups
AGENTERA_CLOUD_ENCRYPTED_BACKUP_REGION=us-east-1
AGENTERA_CLOUD_ENCRYPTED_BACKUP_ACCESS_KEY=aera-backup-dev
AGENTERA_CLOUD_ENCRYPTED_BACKUP_SECRET_KEY=aera-backup-dev-only
AGENTERA_CLOUD_ENCRYPTED_BACKUP_USE_TLS=false

# Internal Admin is disabled until every TLS, service identity, and HMAC setting is injected.
AGENTERA_CLOUD_INTERNAL_ADMIN_ENABLED=false

# Development-only identity key rings. Generate independent production secrets and inject them through the deploy environment.
AGENTERA_CLOUD_IDENTITY_ENCRYPTION_ACTIVE_KEY_ID=enc-dev-v1
AGENTERA_CLOUD_IDENTITY_ENCRYPTION_KEYS='{"enc-dev-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}'
AGENTERA_CLOUD_IDENTITY_LOOKUP_ACTIVE_KEY_ID=lookup-dev-v1
AGENTERA_CLOUD_IDENTITY_LOOKUP_KEYS='{"lookup-dev-v1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="}'

AGENTERA_CLOUD_VERIFICATION_CODE_ACTIVE_KEY_ID=code-dev-v1
AGENTERA_CLOUD_VERIFICATION_CODE_KEYS='{"code-dev-v1":"AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM="}'
AGENTERA_CLOUD_VERIFICATION_RECEIPT_ACTIVE_KEY_ID=receipt-dev-v1
AGENTERA_CLOUD_VERIFICATION_RECEIPT_KEYS='{"receipt-dev-v1":"BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU="}'
AGENTERA_CLOUD_VERIFICATION_REQUEST_HMAC_KEY=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ=

# Browser account sessions and password-login limits use keys independent from verification and identity indexes.
AGENTERA_CLOUD_BROWSER_SESSION_HMAC_KEY=BgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgY=
AGENTERA_CLOUD_LOGIN_RATE_HMAC_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
AGENTERA_CLOUD_BROWSER_COOKIE_NAME=agentera_dev_session
AGENTERA_CLOUD_BROWSER_SESSION_TTL_SECONDS=900
AGENTERA_CLOUD_LOGIN_IDENTITY_LIMIT=5
AGENTERA_CLOUD_LOGIN_IP_LIMIT=20
AGENTERA_CLOUD_LOGIN_WINDOW_SECONDS=600

# Workspace control-plane quotas and independent mutation rate limits.
AGENTERA_CLOUD_WORKSPACE_ACTIVE_OWNED_LIMIT=10
AGENTERA_CLOUD_WORKSPACE_MEMBER_LIMIT=100
AGENTERA_CLOUD_WORKSPACE_PENDING_INVITE_LIMIT=20
AGENTERA_CLOUD_WORKSPACE_CREATE_RATE_LIMIT=10
AGENTERA_CLOUD_WORKSPACE_CREATE_RATE_WINDOW=1h
AGENTERA_CLOUD_WORKSPACE_INVITE_RATE_LIMIT=20
AGENTERA_CLOUD_WORKSPACE_INVITE_RATE_WINDOW=1h
AGENTERA_CLOUD_WORKSPACE_ACCEPT_RATE_LIMIT=30
AGENTERA_CLOUD_WORKSPACE_ACCEPT_RATE_WINDOW=10m

# Organization control-plane quotas and independent mutation rate limits.
AGENTERA_CLOUD_ORGANIZATION_OWNED_LIMIT=3
AGENTERA_CLOUD_ORGANIZATION_MEMBER_LIMIT=500
AGENTERA_CLOUD_ORGANIZATION_DEPARTMENT_LIMIT=50
AGENTERA_CLOUD_ORGANIZATION_PENDING_INVITE_LIMIT=100
AGENTERA_CLOUD_ORGANIZATION_CREATE_RATE_LIMIT=6
AGENTERA_CLOUD_ORGANIZATION_CREATE_RATE_WINDOW=1h
AGENTERA_CLOUD_ORGANIZATION_INVITE_RATE_LIMIT=30
AGENTERA_CLOUD_ORGANIZATION_INVITE_RATE_WINDOW=1h
AGENTERA_CLOUD_ORGANIZATION_ACCEPT_RATE_LIMIT=30
AGENTERA_CLOUD_ORGANIZATION_ACCEPT_RATE_WINDOW=10m
AGENTERA_CLOUD_ORGANIZATION_MUTATION_RATE_LIMIT=120
AGENTERA_CLOUD_ORGANIZATION_MUTATION_RATE_WINDOW=1h
AGENTERA_CLOUD_ORGANIZATION_HIGH_RISK_RATE_LIMIT=20
AGENTERA_CLOUD_ORGANIZATION_HIGH_RISK_RATE_WINDOW=1h

AGENTERA_CLOUD_TERMS_VERSION=terms-2026-07
AGENTERA_CLOUD_PRIVACY_VERSION=privacy-2026-07

# Desktop OAuth state, refresh tokens, access tokens, and offline entitlements use independent keys.
# Ed25519 values below are complete development-only private keys; never reuse them in production.
AGENTERA_CLOUD_OAUTH_STATE_ENCRYPTION_ACTIVE_KEY_ID=oauth-state-dev-v1
AGENTERA_CLOUD_OAUTH_STATE_ENCRYPTION_KEYS='{"oauth-state-dev-v1":"CAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAg="}'
AGENTERA_CLOUD_OAUTH_STATE_HMAC_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=
AGENTERA_CLOUD_REFRESH_TOKEN_HMAC_KEY=CgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgo=
AGENTERA_CLOUD_ACCESS_SIGNING_ACTIVE_KEY_ID=access-dev-v1
AGENTERA_CLOUD_ACCESS_SIGNING_KEYS='{"access-dev-v1":"CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwtmvn4zLHpFMzK9nQp/fbBV9cXvGgatpm2Ys5+2gQxHOg=="}'
AGENTERA_CLOUD_OFFLINE_SIGNING_ACTIVE_KEY_ID=offline-dev-v1
AGENTERA_CLOUD_OFFLINE_SIGNING_KEYS='{"offline-dev-v1":"DAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwLUTrZtJJAFcoJAu0HkETTrF2+wjBvBpSMENqOtuOfLQ=="}'
# Agent version and policy attestation use one separate ring with purpose-specific signing domains.
AGENTERA_CLOUD_AGENT_CONTROL_SIGNING_ACTIVE_KEY_ID=agent-control-dev-v1
AGENTERA_CLOUD_AGENT_CONTROL_SIGNING_KEYS='{"agent-control-dev-v1":"DQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ0NDQ2RoooLdDgVk6TZRpV5IIkmr8itgsiDm3ZENZueuppLOg=="}'
AGENTERA_CLOUD_OFFLINE_POLICY_VERSION=1
AGENTERA_CLOUD_ACTIVE_DEVICE_LIMIT=5

# Official managed Agents are fail-closed and remain unavailable unless every value is explicitly configured.
AGENTERA_CLOUD_OFFICIAL_AGENTS_ENABLED=false
# Required only when AGENTERA_CLOUD_OFFICIAL_AGENTS_ENABLED=true. Never commit production rollout keys.
# AGENTERA_CLOUD_PLATFORM_ID=00000000-0000-0000-0000-000000000001
# AGENTERA_CLOUD_PLATFORM_KEY=agentera_official
# AGENTERA_CLOUD_PLATFORM_DISPLAY_NAME=AgentEra Official
# AGENTERA_CLOUD_OFFICIAL_ROLLOUT_HMAC_ACTIVE_KEY_ID=rollout-v1
# AGENTERA_CLOUD_OFFICIAL_ROLLOUT_HMAC_KEYS='{"rollout-v1":"replace-with-an-independent-32-byte-base64-key"}'

# Official quality collection is separately disabled. It requires the official Agent control plane and an independent key ring.
AGENTERA_CLOUD_OFFICIAL_QUALITY_ENABLED=false
# AGENTERA_CLOUD_OFFICIAL_QUALITY_PSEUDONYM_HMAC_ACTIVE_KEY_ID=quality-v1
# AGENTERA_CLOUD_OFFICIAL_QUALITY_PSEUDONYM_HMAC_KEYS='{"quality-v1":"replace-with-an-independent-32-byte-base64-key"}'

# Non-delivering local placeholders. Replace every value with the chosen production providers before deployment.
AGENTERA_CLOUD_SMTP_HOST=smtp.agentera.invalid
AGENTERA_CLOUD_SMTP_PORT=587
AGENTERA_CLOUD_SMTP_USERNAME=agentera-dev
AGENTERA_CLOUD_SMTP_PASSWORD=agentera-dev-only
AGENTERA_CLOUD_SMTP_FROM_ADDRESS=accounts@agentera.invalid
AGENTERA_CLOUD_SMTP_FROM_NAME=AgentEra
AGENTERA_CLOUD_SMS_ENDPOINT=https://sms.agentera.invalid/v1/messages
AGENTERA_CLOUD_SMS_API_KEY=agentera-dev-only
AGENTERA_CLOUD_SMS_SENDER_ID=AgentEra
AGENTERA_CLOUD_CAPTCHA_ENDPOINT=https://captcha.agentera.invalid/siteverify
AGENTERA_CLOUD_CAPTCHA_SECRET=agentera-dev-only

# Password hashes are code-versioned Argon2id v=19: 65536 KiB memory, 3 iterations, 1 lane, 16-byte salt, 32-byte output.
